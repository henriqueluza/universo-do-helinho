@using Helinho.Web.Painel
@model Helinho.Web.Pages.Dashboard.IndexModel
@using Helinho.Application.Painel
@using Helinho.Web.Pages.Dashboard
<section class="panel panel-pad" aria-labelledby="t-feed">
    <div class="panel-head"><h2 id="t-feed">Acabou de acontecer</h2><p>Últimas @GetDashboardFeed.WindowHours horas</p></div>
    @if (Model.Feed.IsEmpty)
    {
        <div class="empty" id="feed-vazio">
            <img src="~/img/helinho-corpo.webp" width="182" height="360" alt="" />
            <b>Nenhuma jogada nas últimas @GetDashboardFeed.WindowHours horas</b>
            <p>Quando os alunos voltarem a jogar, as conquistas aparecem aqui.</p>
            <a class="btn" href="@Url.Page("/Alunos/Index")">Ver alunos</a>
        </div>
    }
    else
    {
        <ul class="feed" id="feed">
            @foreach (var e in Model.Feed.Events)
            {
                var tipo = e.QuizType is { } q ? TemaQuiz.Of(q).Css : null;
                <li>
                    <span class="av @tipo" aria-hidden="true">@IndexModel.Initial(e.FirstName)</span>
                    <div><b>@e.FirstName</b><small>@e.Text · @e.UnitName</small></div>
                    @if (e.QuizType is { } qt)
                    {
                        <span class="tag tag-type @tipo"><img src="~/img/@(TemaQuiz.Of(qt).Slug).webp" width="160" height="160" alt="" />@TemaQuiz.Of(qt).Nome</span>
                    }
                    <time datetime="@e.At.ToString("O")">@IndexModel.LocalTime(e.At)</time>
                </li>
            }
        </ul>
    }
</section>
