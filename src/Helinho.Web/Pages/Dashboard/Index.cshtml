@page
@model Helinho.Web.Pages.Dashboard.IndexModel
@using Helinho.Domain
@using Helinho.Application.Painel
@using Helinho.Web.Pages.Dashboard
@{
    ViewData["Title"] = "Dashboard";
    var periodo = Model.Dias;
    var t = Model.Trends;
    var e = Model.Engagement;
    var semana = t.AnswersByDay.TakeLast(7).ToList();
    var maximo = Math.Max(1, semana.Max(d => d.Correct));
    var versus = "vs. período anterior";
}
<section class="scene" aria-label="Resumo do período">
    <svg class="scene-twinkle t1" aria-hidden="true"><use href="#i-spark" /></svg>
    <svg class="scene-twinkle t2" aria-hidden="true"><use href="#i-spark" /></svg>
    <svg class="scene-twinkle t3" aria-hidden="true"><use href="#i-spark" /></svg>
    <div class="scene-copy">
        <p class="hello">@Model.Greeting</p>
        <p class="headline"><span data-count="@t.CorrectAnswers.Value">@IndexModel.Num(t.CorrectAnswers.Value ?? 0)</span><svg class="star" aria-hidden="true"><use href="#i-star" /></svg></p>
        <p class="scene-sub"><b>respostas certas</b> nos últimos @periodo dias
            @if (t.CorrectAnswers.Trend.Direction == TrendDirection.Up){<span class="up">@t.CorrectAnswers.Trend.Text</span>}else{<span>(@t.CorrectAnswers.Trend.Text)</span>}</p>
        <div class="week">
            <ol aria-label="Respostas certas por dia, últimos 7 dias">
                @for (var i = 0; i < semana.Count; i++)
                {
                    var d = semana[i];
                    <li class="@(i == semana.Count - 1 ? "today" : null)" style="--v:@IndexModel.Inv(Math.Round(d.Correct / (double)maximo, 2));--d:@i"><span class="bar"></span><small aria-hidden="true">@IndexModel.DayShort(d.Day)</small><span class="sr">@IndexModel.DayName(d.Day): @d.Correct</span></li>
                }
            </ol>
        </div>
    </div>
    <img class="scene-hero" src="~/img/helinho-corpo.webp" width="182" height="360" alt="" />
    <div class="scene-stats" role="group" aria-label="Alunos ativos, respostas e missões concluídas no período">
        <p class="stat" id="kpi-ativos"><b data-count="@t.ActiveStudents.Value">@IndexModel.Num(t.ActiveStudents.Value ?? 0)</b> alunos ativos</p>
        <p class="stat" id="kpi-respostas"><b data-count="@t.Answers.Value">@IndexModel.Num(t.Answers.Value ?? 0)</b> respostas</p>
        <p class="stat"><b data-count="@e.CompletedQuests.Value">@IndexModel.Num(e.CompletedQuests.Value ?? 0)</b> missões concluídas</p>
    </div>
</section>

<form method="get" class="filters" aria-label="Filtros do dashboard">
    <div class="chips" role="group" aria-label="Faixa etária">
        <a class="chip" href="@Model.Link(null)" aria-current="@(Model.Faixa is null ? "true" : "false")">Todas as idades</a>
        @foreach (var band in Enum.GetValues<AgeBand>())
        {
            <a class="chip" href="@Model.Link(band)" aria-current="@(Model.Faixa == band ? "true" : "false")">@IndexModel.BandLabel(band) anos</a>
        }
    </div>
    @if (Model.Faixa is { } f)
    {
        <input type="hidden" name="faixa" value="@f" />
    }
    <div class="filters-end">
        @if (Model.IsMaster)
        {
            <span class="field-inline"><label for="unidade">Unidade</label>
            <select id="unidade" name="unidade" class="select">
                <option value="">Todas as unidades</option>
                @foreach (var u in Model.Result.Units)
                {
                    <option value="@u.Id" selected="@(u.Id == Model.Unidade)">@u.Name</option>
                }
            </select></span>
        }
        <span class="field-inline"><label for="dias">Período</label>
        <select id="dias" name="dias" class="select">
            @foreach (var d in GetDashboard.AllowedDays)
            {
                <option value="@d" selected="@(d == periodo)">Últimos @d dias</option>
            }
        </select></span>
        <button type="submit" class="btn">Aplicar</button>
        @if (Model.HasFilters)
        {
            <a class="btn btn-sm" href="@Url.Page("/Dashboard/Index")">Limpar filtros</a>
        }
    </div>
</form>

@if (t.IsEmpty)
{
    <div class="empty" id="dashboard-vazio">
        <img src="~/img/helinho-corpo.webp" width="182" height="360" alt="" />
        <b>Nenhuma resposta neste período.</b>
        <p>Ajuste a faixa etária, o período ou a unidade para ver os indicadores.</p>
    </div>
}
else
{
    <section class="kpis" aria-label="Indicadores do período">
        <partial name="_Kpi" model="@(new KpiView("Taxa de acerto", "i-target", t.AccuracyPercent.Value?.ToString() ?? "—", t.AccuracyPercent.Value is null ? "" : "%", t.AccuracyPercent.Trend, true, versus,
            IndexModel.Spark(semana.Select(d => (double?)d.AccuracyPercent))))" />
        <partial name="_Kpi" model="@(new KpiView("Tempo médio por sessão", "i-clock", e.AverageSessionMinutes.Value?.ToString() ?? "—", e.AverageSessionMinutes.Value is null ? "" : "min", e.AverageSessionMinutes.Trend, null, versus,
            IndexModel.Spark(e.LastDays.Select(d => (double?)d.AverageSessionMinutes))))" />
        <partial name="_Kpi" model="@(new KpiView("Sessões por aluno", "i-play", e.SessionsPerStudent.Value?.ToString() ?? "—", e.SessionsPerStudent.Value is null ? "" : "no período", e.SessionsPerStudent.Trend, true, versus,
            IndexModel.Spark(e.LastDays.Select(d => (double?)d.SessionsPerStudent))))" />
        <partial name="_Kpi" model="@(new KpiView("Sem jogar há 7+ dias", "i-moon", IndexModel.Num(e.InactiveStudents.Value ?? 0), "alunos", e.InactiveStudents.Trend, false, "precisa de atenção",
            IndexModel.Spark(e.LastDays.Select(d => (double?)d.InactiveStudents)), Url.Page("/Alunos/Index")))" />
    </section>

    <section class="panel panel-pad chart-card" aria-labelledby="t-resp">
        <div class="panel-head">
            <div><h2 id="t-resp">Respostas por dia</h2><p>Últimos @periodo dias · @IndexModel.Num(t.Answers.Value ?? 0) respostas, <b class="@(t.Answers.Trend.Direction == TrendDirection.Up ? "txt-good" : null)">@t.Answers.Trend.Text</b> sobre os @periodo anteriores</p></div>
            <ul class="legend" aria-hidden="true"><li><i class="sw sw-data"></i>Últimos @periodo dias</li><li><i class="sw sw-ref"></i>@periodo dias anteriores</li></ul>
        </div>
        <div class="linechart" data-fonte="tab-resp" tabindex="0" role="img" aria-label="Linha de respostas por dia nos últimos @periodo dias, comparada aos @periodo anteriores. Use as setas para percorrer os dias; os números estão na tabela logo abaixo."></div>
        <details class="chart-table"><summary><svg class="icon" aria-hidden="true"><use href="#i-table" /></svg>Ver em tabela</summary>
            <div class="tscroll">
                <table id="tab-resp" class="dtable">
                    <caption class="sr">Respostas por dia</caption>
                    <thead><tr><th scope="col">Dia</th><th scope="col">Últimos @periodo dias</th><th scope="col">@periodo dias anteriores</th></tr></thead>
                    <tbody>
                        @foreach (var d in t.AnswersByDay)
                        {
                            <tr><th scope="row" data-curto="@IndexModel.DateShort(d.Day)">@IndexModel.DayLabel(d.Day)</th><td>@d.Answers</td><td>@d.PreviousAnswers</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    </section>

    <h2 class="section-title">Acerto médio por tipo de quiz</h2>
    <div class="kpi-grid mb-4">
        @foreach (var tipo in t.AccuracyByType)
        {
            <div class="card-panel kpi @IndexModel.TypeClass(tipo.QuizType)">
                <p class="muted kpi-label"><span class="type-mark" aria-hidden="true"></span>@IndexModel.TypeLabel(tipo.QuizType)</p>
                @if (tipo.AccuracyPercent is { } pct)
                {
                    <p class="kpi-value">@pct%</p>
                    <div class="progress" role="progressbar" aria-label="Acerto em @IndexModel.TypeLabel(tipo.QuizType)" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar type-bar" style="width: @(pct)%"></div>
                    </div>
                    <p class="muted kpi-context">@tipo.Answers respostas</p>
                }
                else
                {
                    <p class="kpi-value">—</p>
                    <p class="muted kpi-context">Sem respostas</p>
                }
            </div>
        }
    </div>

    <h2 class="section-title">Atividade recente</h2>
    <div class="card-panel p-0">
        <table class="table mb-0">
            <caption class="visually-hidden">Últimas respostas dos alunos</caption>
            <thead>
                <tr><th scope="col">Aluno</th><th scope="col">Quiz</th><th scope="col">Resultado</th><th scope="col">Quando</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Result.Recent)
                {
                    <tr>
                        <td>@r.StudentName</td>
                        <td><span class="badge type-badge @IndexModel.TypeClass(r.QuizType)">@IndexModel.TypeLabel(r.QuizType)</span></td>
                        <td>
                            @if (r.IsCorrect)
                            {
                                <span class="badge badge-ok">Acertou</span>
                            }
                            else
                            {
                                <span class="badge badge-miss">Errou</span>
                            }
                        </td>
                        <td><time datetime="@r.AnsweredAt.ToString("O")">@r.AnsweredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
