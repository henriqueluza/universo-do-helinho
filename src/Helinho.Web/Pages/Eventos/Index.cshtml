@page
@model Helinho.Web.Pages.Eventos.IndexModel
@using Helinho.Application.LiveEvents
@using Helinho.Domain
@{
    ViewData["Title"] = "Eventos";
    var titleError = ModelState["Input.Title"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var subtitleError = ModelState["Input.Subtitle"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var typeError = ModelState["Input.QuizType"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var endsError = ModelState["Input.EndsAt"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var hasErrors = titleError is not null || subtitleError is not null || typeError is not null || endsError is not null;
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="page-title mb-0">Eventos</h1>
    <a class="btn btn-primary" href="#novo-evento">Novo evento</a>
</div>

@if (Model.Saved is not null)
{
    <div class="alert alert-success" role="status">@Model.Saved</div>
}

<div class="card-panel mb-4">
    @if (Model.Events.Count == 0)
    {
        <p class="mb-1 fw-semibold">Nenhum evento cadastrado.</p>
        <p class="muted mb-0">Use o formulário abaixo para criar o primeiro evento.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">Eventos, com tipo de quiz, término (horário de Brasília) e situação</caption>
                <thead>
                    <tr><th scope="col">Título</th><th scope="col">Tipo de quiz</th><th scope="col">Término (Brasília)</th><th scope="col">Situação</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Events)
                    {
                        <tr>
                            <th scope="row" class="fw-medium">
                                @e.Title
                                @if (e.Subtitle.Length > 0)
                                {
                                    <div class="muted fw-normal small">@e.Subtitle</div>
                                }
                            </th>
                            <td><span class="badge quiz-@e.QuizType.ToString().ToLowerInvariant()" style="background: var(--quiz-bg); color: var(--quiz-ink)">@IndexModel.QuizLabel(e.QuizType)</span></td>
                            <td style="font-variant-numeric: tabular-nums">@BrasiliaTime.ToLocal(e.EndsAt).ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (e.Active)
                                {
                                    <span class="badge" style="background: var(--pill-positive-bg); color: var(--pill-positive-ink)">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge" style="background: var(--pill-neutral-bg); color: var(--pill-neutral-ink)">Encerrado</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<section class="card-panel" id="novo-evento" aria-labelledby="novo-evento-titulo" style="max-width: 640px">
    <h2 class="h5 fw-semibold mb-3" id="novo-evento-titulo">Novo evento</h2>
    <form method="post" novalidate>
        @if (hasErrors)
        {
            <div class="alert alert-danger" role="alert" tabindex="-1" id="resumo-erros" autofocus>
                @if (titleError is not null) { <div><a href="#Input_Title">@titleError</a></div> }
                @if (subtitleError is not null) { <div><a href="#Input_Subtitle">@subtitleError</a></div> }
                @if (typeError is not null) { <div><a href="#Input_QuizType">@typeError</a></div> }
                @if (endsError is not null) { <div><a href="#Input_EndsAt">@endsError</a></div> }
            </div>
        }
        <div class="mb-3">
            <label class="form-label" asp-for="Input.Title">Título <span class="muted">(obrigatório)</span></label>
            <input class="form-control @(titleError is null ? "" : "is-invalid")" asp-for="Input.Title" maxlength="120" autocomplete="off"
                   aria-invalid="@(titleError is null ? null : "true")" aria-describedby="@(titleError is null ? null : "Input_Title-erro")" />
            @if (titleError is not null) { <div id="Input_Title-erro" class="form-text text-negative">@titleError</div> }
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Input.Subtitle">Subtítulo</label>
            <input class="form-control @(subtitleError is null ? "" : "is-invalid")" asp-for="Input.Subtitle" maxlength="200" autocomplete="off"
                   aria-invalid="@(subtitleError is null ? null : "true")" aria-describedby="@(subtitleError is null ? null : "Input_Subtitle-erro")" />
            @if (subtitleError is not null) { <div id="Input_Subtitle-erro" class="form-text text-negative">@subtitleError</div> }
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Input.QuizType">Tipo de quiz <span class="muted">(obrigatório)</span></label>
            <select class="form-select @(typeError is null ? "" : "is-invalid")" asp-for="Input.QuizType"
                    aria-invalid="@(typeError is null ? null : "true")" aria-describedby="@(typeError is null ? null : "Input_QuizType-erro")">
                <option value="">Selecione</option>
                @foreach (var t in Enum.GetValues<QuizType>())
                {
                    <option value="@t" selected="@(Model.Input.QuizType == t)">@IndexModel.QuizLabel(t)</option>
                }
            </select>
            @if (typeError is not null) { <div id="Input_QuizType-erro" class="form-text text-negative">@typeError</div> }
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Input.EndsAt">Término <span class="muted">(obrigatório)</span></label>
            <input class="form-control @(endsError is null ? "" : "is-invalid")" asp-for="Input.EndsAt" type="datetime-local" step="60"
                   aria-invalid="@(endsError is null ? null : "true")" aria-describedby="Input_EndsAt-ajuda@(endsError is null ? "" : " Input_EndsAt-erro")" />
            <div id="Input_EndsAt-ajuda" class="form-text muted">Horário de Brasília.</div>
            @if (endsError is not null) { <div id="Input_EndsAt-erro" class="form-text text-negative">@endsError</div> }
        </div>
        <button class="btn btn-primary" type="submit">Salvar</button>
    </form>
</section>
