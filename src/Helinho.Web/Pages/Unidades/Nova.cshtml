@page
@model Helinho.Web.Pages.Unidades.NovaModel
@{
    ViewData["Title"] = "Nova unidade";
    var erro = ModelState["Input.Name"]?.Errors.Count > 0;
}
<div class="card-panel" style="max-width: 480px">
    <form method="post" novalidate>
        <partial name="_ResumoErros" view-data="ViewData" />
        <div class="mb-3">
            <label class="form-label" asp-for="Input.Name">Nome da unidade <span class="muted">(obrigatório)</span></label>
            <input class="form-control @(erro ? "is-invalid" : "")" asp-for="Input.Name" maxlength="120" autofocus
                   aria-invalid="@(erro ? "true" : null)" aria-describedby="@(erro ? "Input_Name-erro" : null)" />
            <span id="Input_Name-erro" class="form-text text-negative" asp-validation-for="Input.Name"></span>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Criar unidade</button>
            <a class="btn btn-outline-secondary" href="/Unidades">Cancelar</a>
        </div>
    </form>
</div>
