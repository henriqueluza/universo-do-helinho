@page
@model Helinho.Web.Pages.Unidades.NovaModel
@{
    ViewData["Title"] = "Nova unidade";
    var erro = ModelState["Input.Name"]?.Errors.Count > 0;
}
<form class="panel panel-pad form" method="post" novalidate style="max-width: 560px">
    <partial name="_ResumoErros" view-data="ViewData" />
    <div class="field">
        <label asp-for="Input.Name">Nome da unidade <span class="req">(obrigatório)</span></label>
        <input class="input" asp-for="Input.Name" maxlength="120" autofocus
               aria-invalid="@(erro ? "true" : null)" aria-describedby="@(erro ? "Input_Name-erro" : null)" />
        <span id="Input_Name-erro" class="field-error" asp-validation-for="Input.Name"></span>
    </div>
    <div class="form-actions">
        <button class="btn btn-primary" type="submit">Criar unidade</button>
        <a class="btn" href="/Unidades">Cancelar</a>
    </div>
</form>
