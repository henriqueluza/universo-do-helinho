@page
@model Helinho.Web.Pages.Unidades.IndexModel
@{
    ViewData["Title"] = "Unidades";
}
<div class="page-head">
    <div><p class="sub">@Model.Units.Count unidade(s) cadastrada(s)</p></div>
    <div class="page-actions">
        <a class="btn btn-primary" href="/Unidades/Nova"><svg aria-hidden="true"><use href="#i-plus" /></svg>Nova unidade</a>
    </div>
</div>
<section class="panel panel-pad" aria-label="Unidades">
    @if (Model.Units.Count == 0)
    {
        <div class="empty">
            <img src="~/img/cara-helinho.webp" alt="" width="117" height="120" />
            <b>Nenhuma unidade cadastrada.</b>
            <p>Crie a primeira com “Nova unidade”.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th scope="col">Nome</th></tr></thead>
                <tbody>
                    @foreach (var u in Model.Units)
                    {
                        <tr><th scope="row">@u.Name</th></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
