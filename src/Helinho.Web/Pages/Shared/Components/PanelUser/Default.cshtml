@model PanelUserModel
@{
    var current = Context.Request.Path.Value ?? "/";
    bool Matches(NavItem i) => current.Equals(i.Path, StringComparison.OrdinalIgnoreCase)
        || current.StartsWith(i.Path + "/", StringComparison.OrdinalIgnoreCase)
        || (i.Path == "/Dashboard" && current == "/");
    // Só o item de caminho mais longo fica ativo: /Questoes/Ia não acende também "Questões".
    var best = Model.Items.Where(Matches).OrderByDescending(i => i.Path.Length).FirstOrDefault();
    bool Active(NavItem i) => i == best;
    var groupIndex = 0;
}
<aside class="rail offcanvas-md offcanvas-start" id="menu" tabindex="-1" aria-label="Menu do painel">
    <button class="rail-close" type="button" data-bs-dismiss="offcanvas" data-bs-target="#menu" aria-label="Fechar menu"><svg class="icon" aria-hidden="true"><use href="#i-x" /></svg></button>
    <a class="rail-logo" href="/Dashboard"><img src="~/img/logo-jogo.webp" width="480" height="162" alt="Universo do Helinho" /></a>
    <nav aria-label="Seções do painel">
        @foreach (var group in Model.Groups)
        {
            groupIndex++;
            var labelId = "menu-grupo-" + groupIndex;
            if (group.Key is not null)
            {
                <p class="nav-label" id="@labelId">@group.Key</p>
            }
            <ul class="nav" aria-labelledby="@(group.Key is null ? null : labelId)">
                @foreach (var item in group)
                {
                    <li>
                        <a href="@item.Path" aria-current="@(Active(item) ? "page" : null)">
                            <span class="tile" style="--t:var(--tile-@item.Tile)"><svg aria-hidden="true"><use href="#@item.Icon" /></svg></span>@item.Label
                        </a>
                    </li>
                }
            </ul>
        }
    </nav>
    <div class="rail-foot">
        <button class="tema-btn" type="button" data-tema aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#i-moon" /></svg>Tema escuro</button>
        <div class="me user-block">
            <span class="av" aria-hidden="true">@Model.Initials</span>
            <b>@Model.Name</b>
            <small><span>@Model.Role</span><span>@Model.Unit</span></small>
            <form method="post" asp-page="/Conta/Sair">
                <button type="submit">Sair</button>
            </form>
        </div>
        <div class="org">
            <img class="only-light" src="~/img/fundhas.webp" width="480" height="127" alt="FUNDHAS" />
            <img class="only-dark" src="~/img/fundhas-invertido.webp" width="480" height="127" alt="FUNDHAS" />
        </div>
    </div>
</aside>
