@page "{id:guid}"
@model Helinho.Web.Pages.Missoes.EditarModel
@using Helinho.Domain
@{
    ViewData["Title"] = "Editar missão";
    var titleErr = Model.Error("Title");
    var targetErr = Model.Error("Target");
    var rewardErr = Model.Error("RewardXp");
    var generalErr = ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}
<div>
    <a class="back" asp-page="Index"><svg class="icon" aria-hidden="true"><use href="#i-back" /></svg>Missões</a>
</div>
<form class="panel panel-pad form" method="post" novalidate>
    @if (titleErr is not null || targetErr is not null || rewardErr is not null || generalErr is not null)
    {
        <div class="alert" role="alert" tabindex="-1" id="resumo-erros">
            <svg aria-hidden="true"><use href="#i-alert" /></svg>
            <ul>
                @if (titleErr is not null) { <li><a href="#Input_Title">@titleErr</a></li> }
                @if (targetErr is not null) { <li><a href="#Input_Target">@targetErr</a></li> }
                @if (rewardErr is not null) { <li><a href="#Input_RewardXp">@rewardErr</a></li> }
                @if (generalErr is not null) { <li>@generalErr</li> }
            </ul>
        </div>
    }
    <div class="form-grid">
        <div class="field full">
            <label for="Input_Title">Título <span class="req">(obrigatório)</span></label>
            <input class="input" asp-for="Input.Title" maxlength="120"
                   aria-invalid="@(titleErr is null ? null : "true")" aria-describedby="@(titleErr is null ? null : "Input_Title-erro")" />
            @if (titleErr is not null) { <p id="Input_Title-erro" class="field-error">@titleErr</p> }
        </div>
        <div class="field">
            <label for="Input_Target">Meta (respostas) <span class="req">(obrigatório)</span></label>
            <input class="input" asp-for="Input.Target" type="number" min="1" inputmode="numeric"
                   aria-invalid="@(targetErr is null ? null : "true")" aria-describedby="@(targetErr is null ? null : "Input_Target-erro")" />
            @if (targetErr is not null) { <p id="Input_Target-erro" class="field-error">@targetErr</p> }
        </div>
        <div class="field">
            <label for="Input_RewardXp">Recompensa (XP) <span class="req">(obrigatório)</span></label>
            <input class="input" asp-for="Input.RewardXp" type="number" min="1" inputmode="numeric"
                   aria-invalid="@(rewardErr is null ? null : "true")" aria-describedby="@(rewardErr is null ? null : "Input_RewardXp-erro")" />
            @if (rewardErr is not null) { <p id="Input_RewardXp-erro" class="field-error">@rewardErr</p> }
        </div>
        <div class="field full">
            <label for="Input_QuizType">Tipo de quiz</label>
            <select class="select select-lg" asp-for="Input.QuizType">
                <option value="">Genérica (qualquer quiz)</option>
                @foreach (var t in Enum.GetValues<QuizType>())
                {
                    <option value="@t" selected="@(Model.Input.QuizType == t)">@Helinho.Web.Pages.Missoes.IndexModel.TypeLabel(t)</option>
                }
            </select>
        </div>
    </div>
    <div class="form-actions">
        <button class="btn btn-primary" type="submit">Salvar</button>
        <a class="btn" asp-page="Index">Cancelar</a>
    </div>
</form>
