@page "{id:guid}"
@model Helinho.Web.Pages.Missoes.EditarModel
@using Helinho.Domain
@{
    ViewData["Title"] = "Editar missão";
    var titleErr = Model.Error("Title");
    var targetErr = Model.Error("Target");
    var rewardErr = Model.Error("RewardXp");
    var generalErr = ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}
<div class="card-panel" style="max-width: 36rem">
    <form method="post" novalidate>
        @if (titleErr is not null || targetErr is not null || rewardErr is not null || generalErr is not null)
        {
            <div class="alert alert-danger" role="alert" tabindex="-1" id="resumo-erros">
                <ul class="mb-0">
                    @if (titleErr is not null) { <li><a href="#Input_Title">@titleErr</a></li> }
                    @if (targetErr is not null) { <li><a href="#Input_Target">@targetErr</a></li> }
                    @if (rewardErr is not null) { <li><a href="#Input_RewardXp">@rewardErr</a></li> }
                    @if (generalErr is not null) { <li>@generalErr</li> }
                </ul>
            </div>
        }
        <div class="mb-3">
            <label class="form-label" for="Input_Title">Título <span class="muted">(obrigatório)</span></label>
            <input class="form-control @(titleErr is null ? "" : "is-invalid")" asp-for="Input.Title" maxlength="120"
                   aria-invalid="@(titleErr is null ? null : "true")" aria-describedby="@(titleErr is null ? null : "Input_Title-erro")" />
            @if (titleErr is not null) { <div id="Input_Title-erro" class="form-text text-negative">@titleErr</div> }
        </div>
        <div class="mb-3">
            <label class="form-label" for="Input_Target">Meta (respostas) <span class="muted">(obrigatório)</span></label>
            <input class="form-control @(targetErr is null ? "" : "is-invalid")" asp-for="Input.Target" type="number" min="1" inputmode="numeric"
                   aria-invalid="@(targetErr is null ? null : "true")" aria-describedby="@(targetErr is null ? null : "Input_Target-erro")" />
            @if (targetErr is not null) { <div id="Input_Target-erro" class="form-text text-negative">@targetErr</div> }
        </div>
        <div class="mb-3">
            <label class="form-label" for="Input_RewardXp">Recompensa (XP) <span class="muted">(obrigatório)</span></label>
            <input class="form-control @(rewardErr is null ? "" : "is-invalid")" asp-for="Input.RewardXp" type="number" min="1" inputmode="numeric"
                   aria-invalid="@(rewardErr is null ? null : "true")" aria-describedby="@(rewardErr is null ? null : "Input_RewardXp-erro")" />
            @if (rewardErr is not null) { <div id="Input_RewardXp-erro" class="form-text text-negative">@rewardErr</div> }
        </div>
        <div class="mb-4">
            <label class="form-label" for="Input_QuizType">Tipo de quiz</label>
            <select class="form-select" asp-for="Input.QuizType">
                <option value="">Genérica (qualquer quiz)</option>
                @foreach (var t in Enum.GetValues<QuizType>())
                {
                    <option value="@t" selected="@(Model.Input.QuizType == t)">@Helinho.Web.Pages.Missoes.IndexModel.TypeLabel(t)</option>
                }
            </select>
        </div>
        <button class="btn btn-primary" type="submit">Salvar</button>
        <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
    </form>
</div>
