@page
@model Helinho.Web.Pages.Administradores.IndexModel
@{
    ViewData["Title"] = "Administradores";
}
<div class="page-head">
    <div><p class="sub">@Model.Rows.Count administrador(es) cadastrado(s)</p></div>
    <div class="page-actions">
        <a class="btn btn-primary" href="/Administradores/Novo"><svg aria-hidden="true"><use href="#i-plus" /></svg>Novo administrador</a>
    </div>
</div>
<section class="panel panel-pad" aria-label="Administradores">
    @if (Model.Rows.Count == 0)
    {
        <div class="empty">
            <img src="~/img/cara-helinho.webp" alt="" width="117" height="120" />
            <b>Nenhum administrador cadastrado.</b>
            <p>Crie o primeiro com “Novo administrador”.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr><th scope="col">Usuário</th><th scope="col">E-mail</th><th scope="col">Unidade</th><th scope="col">Situação</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <th scope="row">@r.UserName</th>
                            <td>@r.Email</td>
                            <td>@r.UnitName</td>
                            <td><span class="tag @(r.Active ? "tag-ok" : "tag-neutral")">@(r.Active ? "Ativo" : "Inativo")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
