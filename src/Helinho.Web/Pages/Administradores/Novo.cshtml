@page
@using Helinho.Application.Identidade
@model Helinho.Web.Pages.Administradores.NovoModel
@{
    ViewData["Title"] = "Novo administrador";
    bool Erro(string campo) => ModelState[campo]?.Errors.Count > 0;
    string? Aria(string campo) => Erro(campo) ? "true" : null;
    string? Desc(string campo) => Erro(campo) ? campo.Replace('.', '_') + "-erro" : null;
}
@if (Model.Units.Count == 0)
{
    <section class="panel panel-pad">
        <p>Cadastre uma unidade antes de criar administradores.</p>
        <div class="page-actions"><a class="btn btn-primary" href="/Unidades/Nova"><svg aria-hidden="true"><use href="#i-plus" /></svg>Nova unidade</a></div>
    </section>
}
else
{
    <form class="panel panel-pad form" method="post" novalidate>
        <partial name="_ResumoErros" view-data="ViewData" />
        <div class="form-grid">
            <div class="field">
                <label asp-for="Input.UserName">Nome de usuário <span class="req">(obrigatório)</span></label>
                <input class="input" asp-for="Input.UserName" maxlength="60" autocomplete="off" autofocus="@(ModelState.IsValid ? "autofocus" : null)"
                       aria-invalid="@Aria("Input.UserName")" aria-describedby="@Desc("Input.UserName")" />
                <span id="Input_UserName-erro" class="field-error" asp-validation-for="Input.UserName"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Email">E-mail <span class="req">(obrigatório)</span></label>
                <input class="input" asp-for="Input.Email" type="email" maxlength="200" autocomplete="off"
                       aria-invalid="@Aria("Input.Email")" aria-describedby="Input_Email-ajuda @Desc("Input.Email")" />
                <small id="Input_Email-ajuda">A pessoa recebe neste endereço um link para criar a própria senha. O link vale @LinkDeAcesso.ValidadeConvite.TotalHours horas.</small>
                <span id="Input_Email-erro" class="field-error" asp-validation-for="Input.Email"></span>
            </div>
            <div class="field">
                <label asp-for="Input.UnitId">Unidade <span class="req">(obrigatório)</span></label>
                <select class="select select-lg" asp-for="Input.UnitId"
                        aria-invalid="@Aria("Input.UnitId")" aria-describedby="@Desc("Input.UnitId")">
                    <option value="">Selecione a unidade</option>
                    @foreach (var u in Model.Units)
                    {
                        <option value="@u.Id" selected="@(Model.Input.UnitId == u.Id)">@u.Name</option>
                    }
                </select>
                <span id="Input_UnitId-erro" class="field-error" asp-validation-for="Input.UnitId"></span>
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Criar e enviar convite</button>
            <a class="btn" href="/Administradores">Cancelar</a>
        </div>
    </form>
}
