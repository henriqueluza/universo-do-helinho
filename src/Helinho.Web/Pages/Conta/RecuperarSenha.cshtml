@page
@model Helinho.Web.Pages.Conta.RecuperarSenhaModel
@{
    ViewData["Title"] = "Recuperar senha";
    Layout = "_Bare";
    var emailError = ModelState["Input.Email"]?.Errors.FirstOrDefault()?.ErrorMessage;
}
<div class="card-panel auth-card">
    <h1 class="page-title">Recuperar senha</h1>
    @if (Model.Sent)
    {
        <div class="alert alert-info" role="status">
            Se o e-mail estiver cadastrado, enviaremos as instruções para recuperar a senha.
        </div>
    }
    else
    {
        <form method="post" novalidate>
            @if (emailError is not null)
            {
                <div class="alert alert-danger" role="alert" tabindex="-1" id="resumo-erros">
                    <a href="#Input_Email">@emailError</a>
                </div>
            }
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Email">E-mail <span class="muted">(obrigatório)</span></label>
                <input class="form-control @(emailError is null ? "" : "is-invalid")" asp-for="Input.Email" type="email"
                       autocomplete="email" autocapitalize="none" autofocus
                       aria-invalid="@(emailError is null ? null : "true")" aria-describedby="@(emailError is null ? null : "Input_Email-erro")" />
                @if (emailError is not null)
                {
                    <div id="Input_Email-erro" class="form-text text-negative">@emailError</div>
                }
            </div>
            <button class="btn btn-primary w-100" type="submit">Enviar instruções</button>
        </form>
    }
    <p class="mt-3 mb-0"><a href="/entrar">Voltar para o login</a></p>
</div>
