@page
@model Helinho.Web.Pages.Conta.RecuperarSenhaModel
@{
    ViewData["Title"] = "Recuperar senha";
    Layout = "_Bare";
    var emailError = ModelState["Input.Email"]?.Errors.FirstOrDefault()?.ErrorMessage;
}
<main id="conteudo" class="bare-card" tabindex="-1">
    <span class="face-solo"><img src="~/img/cara-helinho.webp" width="312" height="320" alt="" /></span>
    <h1 class="page-title">Recuperar senha</h1>
    <p class="lede">Informe o e-mail cadastrado. Se ele existir, enviaremos as instruções.</p>
    @if (Model.Sent)
    {
        <div class="note info" role="status">
            <svg aria-hidden="true"><use href="#i-info" /></svg>
            <span>Se o e-mail estiver cadastrado, enviaremos as instruções para recuperar a senha.</span>
        </div>
    }
    else
    {
        <form method="post" novalidate>
            @if (emailError is not null)
            {
                <div class="alert" role="alert" tabindex="-1" id="resumo-erros">
                    <svg aria-hidden="true"><use href="#i-alert" /></svg>
                    <a href="#Input_Email">@emailError</a>
                </div>
            }
            <div class="field">
                <label asp-for="Input.Email">E-mail <span class="req">(obrigatório)</span></label>
                <input class="input" asp-for="Input.Email" type="email"
                       autocomplete="email" autocapitalize="none" autofocus
                       aria-invalid="@(emailError is null ? null : "true")" aria-describedby="@(emailError is null ? null : "Input_Email-erro")" />
                @if (emailError is not null)
                {
                    <div id="Input_Email-erro" class="field-error">@emailError</div>
                }
            </div>
            <button class="btn btn-primary btn-lg" type="submit">Enviar instruções</button>
        </form>
    }
    <a class="link" href="/entrar">Voltar para o login</a>
</main>
