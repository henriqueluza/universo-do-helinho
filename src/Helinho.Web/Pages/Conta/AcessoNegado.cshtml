@page
@{
    ViewData["Title"] = "Acesso negado";
    Layout = "_Bare";
    Response.StatusCode = StatusCodes.Status403Forbidden;
}
<main id="conteudo" class="bare-card" tabindex="-1">
    <span class="face-solo" style="background:var(--q-con-bg)"><img src="~/img/cara-byte.webp" width="320" height="314" alt="" /></span>
    <h1 class="page-title">Acesso negado</h1>
    <p class="lede">Seu perfil não tem permissão para ver esta página.</p>
    <a class="btn btn-primary btn-lg" href="/">Voltar ao início</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form method="post" asp-page="/Conta/Sair">
            <button class="btn btn-lg" type="submit">Sair</button>
        </form>
    }
</main>
