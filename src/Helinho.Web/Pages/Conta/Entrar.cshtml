@page
@model Helinho.Web.Pages.Conta.EntrarModel
@{
    ViewData["Title"] = "Entrar";
    ViewData["Classe"] = "auth";
    Layout = "_Bare";
    var userError = ModelState["Input.UserName"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var passError = ModelState["Input.Password"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var formErrors = ModelState[string.Empty]?.Errors.Select(e => e.ErrorMessage).ToList() ?? [];
}
<section class="auth-scene" aria-label="Universo do Helinho">
    <div class="auth-sky" aria-hidden="true">
        <b class="shoot"></b><b class="shoot s2"></b>
        <em class="sobe" style="--x:22%;--d:0s"></em><em class="sobe" style="--x:31%;--d:1.6s"></em><em class="sobe" style="--x:40%;--d:3.1s"></em><em class="sobe" style="--x:27%;--d:4.4s"></em><em class="sobe" style="--x:36%;--d:5.7s"></em>
        <i style="--x:58%;--y:9%;--s:9px;--t:3.2s;--d:0s"></i>
        <i style="--x:86%;--y:22%;--s:12px;--t:4.1s;--d:-1.2s"></i>
        <i style="--x:93%;--y:52%;--s:8px;--t:3.6s;--d:-2.4s"></i>
        <i style="--x:70%;--y:40%;--s:6px;--t:2.9s;--d:-0.8s"></i>
        <i style="--x:8%;--y:30%;--s:7px;--t:3.8s;--d:-1.9s"></i>
        <i style="--x:47%;--y:30%;--s:5px;--t:3.1s;--d:-2.8s"></i>
        <i style="--x:80%;--y:80%;--s:10px;--t:4.4s;--d:-0.4s"></i>
        <i style="--x:38%;--y:92%;--s:6px;--t:3.4s;--d:-1.5s"></i>
    </div>
    <div class="auth-logos">
        <img class="jogo" src="~/img/logo-jogo.webp" width="480" height="162" alt="Universo do Helinho" />
        <img class="org" src="~/img/fundhas-invertido.webp" width="480" height="127" alt="FUNDHAS" />
    </div>
    <div class="auth-pitch">
        <p class="auth-say"><span class="w"><span style="--w:0">Cada</span></span> <span class="w"><span style="--w:1">resposta</span></span> <span class="w"><span style="--w:2">vira</span></span> <span class="w"><span style="--w:3">uma</span></span> <span class="w"><em style="--w:4">estrela<svg class="star" aria-hidden="true"><use href="#i-star" /></svg></em></span> <span class="w"><span style="--w:5">no</span></span> <span class="w"><span style="--w:6">mapa</span></span> <span class="w"><span style="--w:7">da</span></span> <span class="w"><span style="--w:8">turma.</span></span></p>
        <p class="auth-note">Acompanhe o progresso dos alunos em cada tema do jogo, por unidade e faixa etária.</p>
        <ul class="faces" aria-label="Personagens do jogo">
            <li class="face f-lia"><img src="~/img/cara-lia.webp" width="320" height="320" alt="Lia, tema diversidade" /></li>
            <li class="face f-byte"><img src="~/img/cara-byte.webp" width="320" height="314" alt="Byte, tema conhecimento" /></li>
            <li class="face f-luna"><img src="~/img/cara-luna.webp" width="313" height="320" alt="Luna, tema cultural" /></li>
            <li class="face f-flora"><img src="~/img/cara-flora.webp" width="320" height="316" alt="Flora, tema ambiental" /></li>
            <li class="face f-max"><img src="~/img/cara-max.webp" width="296" height="320" alt="Max, tema esportivo" /></li>
            <li class="face lead"><img src="~/img/cara-helinho.webp" width="312" height="320" alt="Helinho" /></li>
        </ul>
    </div>
    <p class="auth-foot"><svg aria-hidden="true"><use href="#i-lock" /></svg>Acesso restrito a educadores e coordenadores da FUNDHAS.</p>
</section>
<main id="conteudo" class="auth-form" tabindex="-1">
    <div class="auth-card">
        <span class="auth-badge"><svg class="star" aria-hidden="true"><use href="#i-star" /></svg>Painel do educador</span>
        <h1 class="page-title">Entrar no painel</h1>
        <p class="lede">Acompanhe como seus alunos estão jogando, aprendendo e ganhando estrelas.</p>
        @if (!ModelState.IsValid)
        {
            <div class="alert" role="alert" tabindex="-1" id="resumo-erros">
                <svg aria-hidden="true"><use href="#i-alert" /></svg>
                <div>
                    @foreach (var e in formErrors)
                    {
                        <div>@e</div>
                    }
                    @if (userError is not null)
                    {
                        <div><a href="#Input_UserName">@userError</a></div>
                    }
                    @if (passError is not null)
                    {
                        <div><a href="#Input_Password">@passError</a></div>
                    }
                </div>
            </div>
        }
        <form method="post" novalidate>
            <div class="field">
                <label asp-for="Input.UserName">Usuário ou e-mail <span class="req">(obrigatório)</span></label>
                <input class="input" asp-for="Input.UserName" autocomplete="username" autocapitalize="none" autofocus
                       aria-invalid="@(userError is null ? null : "true")" aria-describedby="@(userError is null ? null : "Input_UserName-erro")" />
                @if (userError is not null)
                {
                    <div id="Input_UserName-erro" class="field-error">@userError</div>
                }
            </div>
            <div class="field">
                <label asp-for="Input.Password">Senha <span class="req">(obrigatório)</span></label>
                <input class="input" asp-for="Input.Password" autocomplete="current-password"
                       aria-invalid="@(passError is null ? null : "true")" aria-describedby="@(passError is null ? "senha-dica" : "Input_Password-erro senha-dica")" />
                @if (passError is not null)
                {
                    <div id="Input_Password-erro" class="field-error">@passError</div>
                }
                <small id="senha-dica">Use a senha que a coordenação enviou.</small>
            </div>
            <input type="hidden" asp-for="ReturnUrl" />
            <button class="btn btn-primary btn-lg" type="submit"><span class="btn-label">Entrar</span></button>
        </form>
        <a class="link" href="/recuperar-senha">Esqueci minha senha</a>
    </div>
    <p class="auth-help">Problemas para entrar? Fale com a coordenação da sua unidade.</p>
</main>
