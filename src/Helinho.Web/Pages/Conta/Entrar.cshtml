@page
@model Helinho.Web.Pages.Conta.EntrarModel
@{
    ViewData["Title"] = "Entrar";
    Layout = "_Bare";
}
<div class="card-panel auth-card">
    <h1 class="page-title">Entrar</h1>
    <form method="post" novalidate>
        @{
            var userError = ModelState["Input.UserName"]?.Errors.FirstOrDefault()?.ErrorMessage;
            var passError = ModelState["Input.Password"]?.Errors.FirstOrDefault()?.ErrorMessage;
            var formErrors = ModelState[string.Empty]?.Errors.Select(e => e.ErrorMessage).ToList() ?? [];
        }
        @if (!ModelState.IsValid)
        {
            <div class="alert alert-danger" role="alert" tabindex="-1" id="resumo-erros">
                @foreach (var e in formErrors)
                {
                    <div>@e</div>
                }
                @if (userError is not null)
                {
                    <div><a href="#Input_UserName">@userError</a></div>
                }
                @if (passError is not null)
                {
                    <div><a href="#Input_Password">@passError</a></div>
                }
            </div>
        }
        <div class="mb-3">
            <label class="form-label" asp-for="Input.UserName">Usuário ou e-mail <span class="muted">(obrigatório)</span></label>
            <input class="form-control @(userError is null ? "" : "is-invalid")" asp-for="Input.UserName" autocomplete="username" autocapitalize="none" autofocus
                   aria-invalid="@(userError is null ? null : "true")" aria-describedby="@(userError is null ? null : "Input_UserName-erro")" />
            @if (userError is not null)
            {
                <div id="Input_UserName-erro" class="form-text text-negative">@userError</div>
            }
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Input.Password">Senha <span class="muted">(obrigatório)</span></label>
            <input class="form-control @(passError is null ? "" : "is-invalid")" asp-for="Input.Password" autocomplete="current-password"
                   aria-invalid="@(passError is null ? null : "true")" aria-describedby="@(passError is null ? null : "Input_Password-erro")" />
            @if (passError is not null)
            {
                <div id="Input_Password-erro" class="form-text text-negative">@passError</div>
            }
        </div>
        <input type="hidden" asp-for="ReturnUrl" />
        <button class="btn btn-primary w-100" type="submit">Entrar</button>
    </form>
</div>
