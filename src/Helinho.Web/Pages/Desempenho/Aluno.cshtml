@page "{id:guid}"
@using Helinho.Web.Painel
@model Helinho.Web.Pages.Desempenho.AlunoModel
@using Helinho.Web.Painel
@{
    ViewData["Title"] = Model.Student.FullName;
    var s = Model.Student;
}
<div>
    <a class="back" href="@Url.Page("/Desempenho/Index")"><svg class="icon" aria-hidden="true"><use href="#i-back"/></svg>Voltar ao desempenho</a>
    <section class="profile panel panel-pad" aria-label="Resumo do aluno">
        <span class="av-xl" aria-hidden="true">@AlunoModel.Initials(s.FullName)</span>
        <p class="meta">@s.UnitName · Turma @s.ClassName@(s.Band is null ? "" : $" · {Helinho.Web.Pages.Alunos.IndexModel.BandLabel(s.Band)} anos")</p>
        <div class="level" id="aluno-nivel">
            <small>Nível @s.Level — @s.LevelName</small>
            <b>@s.Xp XP</b>
            <span class="meter" aria-hidden="true"><i style="width: @(AlunoModel.XpPercent(s.Xp, s.NextLevelXp))%"></i></span>
            <small>Próximo nível em @s.NextLevelXp XP</small>
        </div>
    </section>
</div>

<div class="split">
    <section class="panel panel-pad" aria-labelledby="acertos-titulo">
        <div class="panel-head"><h2 id="acertos-titulo">Acertos por tipo de quiz</h2></div>
        @if (s.Answered == 0)
        {
            <p class="muted" id="aluno-sem-respostas">Este aluno ainda não respondeu nenhuma pergunta.</p>
        }
        else
        {
            <div class="table-wrap"><table class="table">
                <caption class="visually-hidden">Acertos por tipo de quiz</caption>
                <thead><tr><th scope="col">Tipo</th><th scope="col" class="num">Respostas</th><th scope="col" class="num">Acertos</th><th scope="col">Aproveitamento</th></tr></thead>
                <tbody>
                    @foreach (var t in s.Scores)
                    {
                        var tema = TemaQuiz.Of(t.Type);
                        var pct = AlunoModel.CorrectPercent(t.Answered, t.Correct);
                        <tr>
                            <td><span class="tag tag-type @tema.Css"><img src="~/img/@tema.Imagem" alt="" width="@tema.Largura" height="@tema.Altura" />@tema.Nome · @tema.Personagem</span></td>
                            <td class="num">@t.Answered</td>
                            <td class="num">@t.Correct</td>
                            <td>
                                @if (t.Answered == 0)
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    <span class="meter meter-inline @tema.Css" aria-hidden="true"><i style="width: @(pct)%"></i></span>
                                    <span>@(pct)%</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table></div>
        }
    </section>

    <section class="panel panel-pad" aria-labelledby="conquistas-titulo">
        <div class="panel-head"><h2 id="conquistas-titulo">Conquistas desbloqueadas</h2></div>
        @if (s.Badges.Count == 0)
        {
            <p class="muted" id="aluno-sem-conquistas">Nenhuma conquista desbloqueada ainda.</p>
        }
        else
        {
            <div class="badges">
                @foreach (var b in s.Badges)
                {
                    <div class="badge-card">
                        @if (AlunoModel.BadgeImage(b.Title) is { } art)
                        {
                            <img src="@art.Src" alt="Selo @b.Title" width="96" height="@art.Height" />
                        }
                        else
                        {
                            <svg class="icon" width="48" height="48" role="img" aria-label="Selo @b.Title"><use href="#i-star"/></svg>
                        }
                        @b.Title
                        <small>Desbloqueado em @AlunoModel.UnlockedOn(b.UnlockedAt)</small>
                    </div>
                }
            </div>
        }
    </section>
</div>
