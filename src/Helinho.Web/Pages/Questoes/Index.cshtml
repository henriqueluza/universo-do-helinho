@page
@model Helinho.Web.Pages.Questoes.IndexModel
@using Helinho.Domain.Entities
@{
    ViewData["Title"] = "Questões";
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="page-title mb-0">Questões</h1>
    <a class="btn btn-primary" asp-page="Editar">Nova questão</a>
</div>

@if (Model.Saved is not null)
{
    <div class="alert alert-success" role="status">@Model.Saved</div>
}

<div class="card-panel">
    @if (Model.Questions.Count == 0)
    {
        <p class="mb-1 fw-semibold">Nenhuma questão cadastrada.</p>
        <p class="muted mb-0">Crie a primeira questão. Ela nasce como rascunho e só chega ao jogo depois de aprovada.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">Questões, com tipo de quiz, faixa etária e situação</caption>
                <thead>
                    <tr><th scope="col">Enunciado</th><th scope="col">Tipo de quiz</th><th scope="col">Faixa etária</th><th scope="col">Situação</th><th scope="col">Ações</th></tr>
                </thead>
                <tbody>
                    @foreach (var q in Model.Questions)
                    {
                        <tr>
                            <th scope="row" class="fw-medium">@q.Statement</th>
                            <td><span class="badge quiz-@q.QuizType.ToString().ToLowerInvariant()" style="background: var(--quiz-bg); color: var(--quiz-ink)">@IndexModel.QuizLabel(q.QuizType)</span></td>
                            <td>@IndexModel.BandLabel(q.AgeBand)</td>
                            <td>
                                @if (q.Status == QuestionStatus.Approved)
                                {
                                    <span class="badge" style="background: var(--pill-positive-bg); color: var(--pill-positive-ink)">Aprovada</span>
                                }
                                else
                                {
                                    <span class="badge" style="background: var(--pill-neutral-bg); color: var(--pill-neutral-ink)">Rascunho</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="Editar" asp-route-id="@q.Id">Editar<span class="visually-hidden"> questão: @q.Statement</span></a>
                                    @if (q.Status == QuestionStatus.Draft)
                                    {
                                        <form method="post" asp-page-handler="Aprovar" asp-route-id="@q.Id">
                                            <button class="btn btn-sm btn-primary" type="submit">Aprovar<span class="visually-hidden"> questão: @q.Statement</span></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
