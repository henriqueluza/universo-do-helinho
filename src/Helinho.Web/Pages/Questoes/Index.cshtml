@page
@using Helinho.Web.Painel
@model Helinho.Web.Pages.Questoes.IndexModel
@using Helinho.Domain
@using Helinho.Domain.Entities
@{
    ViewData["Title"] = "Questões";
}
<div class="page-head">
    <p class="sub">Toda questão nasce como rascunho e só chega ao jogo depois de aprovada.</p>
    <div class="page-actions">
        @if (Model.AiEnabled)
        {
            <a class="btn btn-ai" href="/Questoes/Ia"><svg class="fill" aria-hidden="true"><use href="#i-ai"/></svg>Gerar com IA</a>
        }
        <a class="btn btn-primary" asp-page="Editar"><svg aria-hidden="true"><use href="#i-plus"/></svg>Nova questão</a>
    </div>
</div>

@if (Model.PendingDrafts is { Count: > 0, OldestJobId: { } oldest })
{
    <div class="note ai" id="ia-pendentes"><svg aria-hidden="true"><use href="#i-ai"/></svg><span><b>@(Model.PendingDrafts.Count == 1 ? "1 sugestão da IA esperando revisão." : $"{Model.PendingDrafts.Count} sugestões da IA esperando revisão.")</b> <a class="link-btn" href="/Questoes/Ia/@oldest">Revisar agora</a></span></div>
}

@if (Model.Saved is not null)
{
    <div class="note ok" role="status"><svg aria-hidden="true"><use href="#i-ok"/></svg><span>@Model.Saved</span></div>
}

<form method="get" class="filters-bar" aria-label="Filtros de questões">
    <div class="field">
        <label for="tipo">Tipo de quiz</label>
        <select id="tipo" name="tipo" class="select">
            <option value="">Todos</option>
            @foreach (var t in Enum.GetValues<QuizType>())
            {
                <option value="@t" selected="@(t == Model.Tipo)">@TemaQuiz.Of(t).Nome</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="faixa">Faixa etária</label>
        <select id="faixa" name="faixa" class="select">
            <option value="">Todas</option>
            @foreach (var b in Enum.GetValues<AgeBand>())
            {
                <option value="@b" selected="@(b == Model.Faixa)">@IndexModel.BandLabel(b)</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="status">Status</label>
        <select id="status" name="status" class="select">
            <option value="">Todos</option>
            @foreach (var s in Enum.GetValues<QuestionStatus>())
            {
                <option value="@s" selected="@(s == Model.Status)">@IndexModel.StatusLabel(s)</option>
            }
        </select>
    </div>
    @if (Model.ShowOrigin)
    {
        <div class="field">
            <label for="origem">Origem</label>
            <select id="origem" name="origem" class="select">
                <option value="">Todas</option>
                @foreach (var o in Enum.GetValues<QuestionOrigin>())
                {
                    <option value="@o" selected="@(o == Model.Origem)">@IndexModel.OriginLabel(o)</option>
                }
            </select>
        </div>
    }
    <button type="submit" class="btn">Aplicar</button>
    @if (Model.HasFilters)
    {
        <a class="link" href="@Url.Page("/Questoes/Index")">Limpar filtros</a>
    }
</form>

@if (Model.Result.Total == 0)
{
    <section class="panel panel-pad" id="questoes-vazio" aria-label="Banco de questões">
        <div class="empty">
            <img src="~/img/helinho-corpo.webp" width="182" height="360" alt="" />
            @if (Model.HasFilters)
            {
                <b>Nenhuma questão encontrada.</b>
                <p>Ajuste os filtros para ver outras questões.</p>
                <a class="btn" href="@Url.Page("/Questoes/Index")">Limpar filtros</a>
            }
            else
            {
                <b>Nenhuma questão cadastrada.</b>
                <p>Crie a primeira questão. Ela nasce como rascunho e só chega ao jogo depois de aprovada.</p>
                <a class="btn" asp-page="Editar"><svg aria-hidden="true"><use href="#i-plus"/></svg>Nova questão</a>
            }
        </div>
    </section>
}
else
{
    <section class="panel panel-pad" aria-label="Banco de questões">
        <div class="table-wrap">
            <table class="table">
                <caption class="visually-hidden">Questões cadastradas</caption>
                <thead>
                    <tr><th scope="col">Enunciado</th><th scope="col">Tipo de quiz</th><th scope="col">Faixa etária</th><th scope="col">Status</th><th scope="col" class="actions">Ações</th></tr>
                </thead>
                <tbody>
                    @foreach (var q in Model.Result.Items)
                    {
                        var tema = TemaQuiz.Of(q.QuizType);
                        <tr>
                            <th scope="row"><div class="clip" title="@q.Statement">@q.Statement</div></th>
                            <td><span class="tag tag-type @tema.Css"><img src="~/img/@tema.Imagem" width="@tema.Largura" height="@tema.Altura" alt="" />@tema.Nome<span class="visually-hidden"> (personagem @tema.Personagem)</span></span></td>
                            <td>@IndexModel.BandLabel(q.AgeBand)</td>
                            <td>
                                <div class="cell-tags">
                                    @if (q.Status == QuestionStatus.Approved)
                                    {
                                        <span class="tag tag-ok">Aprovada</span>
                                    }
                                    else
                                    {
                                        <span class="tag tag-draft">Rascunho</span>
                                    }
                                    @if (q.Origin == QuestionOrigin.Ai)
                                    {
                                        @* Selo de origem: aparece mesmo com a IA desligada, porque a origem é um fato sobre o texto. *@
                                        <span class="tag tag-ai"><svg aria-hidden="true"><use href="#i-ai"/></svg>IA@(q.AiEdited ? " · editada" : "")<span class="visually-hidden"> (@(q.AiEdited ? "sugerida pela IA e editada pela equipe" : "sugerida pela IA"))</span></span>
                                    }
                                </div>
                            </td>
                            <td class="actions">
                                <div class="row-actions">
                                    <a class="link-btn" asp-page="Editar" asp-route-id="@q.Id">Editar<span class="visually-hidden"> questão: @q.Statement</span></a>
                                    @if (q.Status == QuestionStatus.Draft)
                                    {
                                        <form method="post" asp-page-handler="Aprovar" asp-route-id="@q.Id" asp-route-tipo="@Model.Tipo" asp-route-faixa="@Model.Faixa" asp-route-status="@Model.Status" asp-route-origem="@Model.Origem" asp-route-pagina="@Model.Pagina">
                                            <button class="btn btn-sm btn-primary" type="submit">Aprovar<span class="visually-hidden"> questão: @q.Statement</span></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="pager">
            <span>@Model.Result.Total @(Model.Result.Total == 1 ? "questão" : "questões") · página @Model.Result.Page de @Model.Result.TotalPages</span>
            @if (Model.Result.TotalPages > 1)
            {
                <nav aria-label="Paginação">
                    @if (Model.Result.Page > 1)
                    {
                        <a class="btn btn-sm" rel="prev" href="@Model.PageLink(Model.Result.Page - 1)">Anterior</a>
                    }
                    @if (Model.Result.Page < Model.Result.TotalPages)
                    {
                        <a class="btn btn-sm" rel="next" href="@Model.PageLink(Model.Result.Page + 1)">Próxima</a>
                    }
                </nav>
            }
        </div>
    </section>
}
