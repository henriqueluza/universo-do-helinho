@page "{id:guid?}"
@model Helinho.Web.Pages.Questoes.EditarModel
@using Helinho.Domain
@{
    var editing = Model.Id is not null;
    ViewData["Title"] = editing ? "Editar questão" : "Nova questão";
    var errors = ModelState.Where(e => e.Value!.Errors.Count > 0)
        .Select(e => (Key: e.Key, Message: e.Value!.Errors[0].ErrorMessage)).ToList();
    string? Err(string field) => ModelState["Input." + field]?.Errors.FirstOrDefault()?.ErrorMessage;
    var letters = new[] { "A", "B", "C", "D" };
    var optionFields = new[] { "OptionA", "OptionB", "OptionC", "OptionD" };
    var optionValues = new[] { Model.Input.OptionA, Model.Input.OptionB, Model.Input.OptionC, Model.Input.OptionD };
}
<h1 class="page-title">@ViewData["Title"]</h1>

<section class="card-panel" aria-label="Formulário da questão" style="max-width: 720px">
    @if (editing)
    {
        <p class="muted">Ao salvar, a questão volta para rascunho e precisa ser aprovada de novo para chegar ao jogo.</p>
    }
    <form method="post" novalidate>
        @if (errors.Count > 0)
        {
            <div class="alert alert-danger" role="alert" tabindex="-1" id="resumo-erros" autofocus>
                @foreach (var e in errors)
                {
                    <div><a href="#@e.Key.Replace('.', '_')">@e.Message</a></div>
                }
            </div>
        }
        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label class="form-label" asp-for="Input.QuizType">Tipo de quiz <span class="muted">(obrigatório)</span></label>
                <select class="form-select @(Err("QuizType") is null ? "" : "is-invalid")" asp-for="Input.QuizType" aria-invalid="@(Err("QuizType") is null ? null : "true")">
                    <option value="">Selecione</option>
                    @foreach (var t in Enum.GetValues<QuizType>())
                    {
                        <option value="@t" selected="@(Model.Input.QuizType == t)">@Helinho.Web.Pages.Questoes.IndexModel.QuizLabel(t)</option>
                    }
                </select>
            </div>
            <div class="col-sm-6">
                <label class="form-label" asp-for="Input.AgeBand">Faixa etária <span class="muted">(obrigatório)</span></label>
                <select class="form-select @(Err("AgeBand") is null ? "" : "is-invalid")" asp-for="Input.AgeBand" aria-invalid="@(Err("AgeBand") is null ? null : "true")">
                    <option value="">Selecione</option>
                    @foreach (var b in Enum.GetValues<AgeBand>())
                    {
                        <option value="@b" selected="@(Model.Input.AgeBand == b)">@Helinho.Web.Pages.Questoes.IndexModel.BandLabel(b)</option>
                    }
                </select>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Input.Statement">Enunciado <span class="muted">(obrigatório)</span></label>
            <textarea class="form-control @(Err("Statement") is null ? "" : "is-invalid")" asp-for="Input.Statement" rows="3" maxlength="500" aria-invalid="@(Err("Statement") is null ? null : "true")"></textarea>
        </div>
        <fieldset class="mb-3">
            <legend class="form-label fs-6">Alternativas <span class="muted">(preencha as quatro e marque a correta)</span></legend>
            @for (var i = 0; i < 4; i++)
            {
                var field = optionFields[i];
                var err = Err(field);
                <div class="d-flex align-items-start gap-2 mb-2">
                    <div class="form-check pt-2">
                        <input class="form-check-input" type="radio" name="Input.Correct" id="Input_Correct_@i" value="@i" checked="@(Model.Input.Correct == i)" />
                        <label class="form-check-label" for="Input_Correct_@i"><span class="visually-hidden">Marcar a alternativa @letters[i] como correta</span></label>
                    </div>
                    <div class="flex-grow-1">
                        <label class="visually-hidden" for="Input_@field">Alternativa @letters[i]</label>
                        <input class="form-control @(err is null ? "" : "is-invalid")" id="Input_@field" name="Input.@field" value="@optionValues[i]" maxlength="300" autocomplete="off"
                               placeholder="Alternativa @letters[i]" aria-invalid="@(err is null ? null : "true")" />
                    </div>
                </div>
            }
            @if (Err("Correct") is { } correctError)
            {
                <div class="form-text text-negative" id="Input_Correct">@correctError</div>
            }
        </fieldset>
        <div class="mb-3">
            <label class="form-label" asp-for="Input.Explanation">Explicação <span class="muted">(obrigatório)</span></label>
            <textarea class="form-control @(Err("Explanation") is null ? "" : "is-invalid")" asp-for="Input.Explanation" rows="3" maxlength="1000" aria-invalid="@(Err("Explanation") is null ? null : "true")"></textarea>
            <div class="form-text muted">Mostrada ao aluno depois que ele responde.</div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Salvar</button>
            <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
        </div>
    </form>
</section>
