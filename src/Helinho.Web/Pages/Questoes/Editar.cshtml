@page "{id:guid?}"
@model Helinho.Web.Pages.Questoes.EditarModel
@using Helinho.Domain
@using Helinho.Web.Pages.Questoes
@{
    var editing = Model.Id is not null;
    ViewData["Title"] = editing ? "Editar questão" : "Nova questão";
    var errors = ModelState.Where(e => e.Value!.Errors.Count > 0)
        .Select(e => (Key: e.Key, Message: e.Value!.Errors[0].ErrorMessage)).ToList();
    string? Err(string field) => ModelState["Input." + field]?.Errors.FirstOrDefault()?.ErrorMessage;
    string? Bad(string field) => Err(field) is null ? null : "true";
    string? Desc(string field) => Err(field) is null ? null : $"Input_{field}-erro";
    string Target(string key) => key.Replace('.', '_');
    var letters = new[] { "A", "B", "C", "D" };
    var optionFields = new[] { "OptionA", "OptionB", "OptionC", "OptionD" };
    var optionValues = new[] { Model.Input.OptionA, Model.Input.OptionB, Model.Input.OptionC, Model.Input.OptionD };
    var bands = Enum.GetValues<AgeBand>();
    var quizTypes = Enum.GetValues<QuizType>();
    var quiz = Model.Input.QuizType;
    var age = Model.Input.AgeBand;
    var statement = Model.Input.Statement?.Trim();
    var explanation = Model.Input.Explanation?.Trim();
    if (explanation is { Length: > 160 }) { explanation = explanation[..160] + "…"; }
    var correct = Model.Input.Correct;
    var checklist = new (string Key, string Label, bool Done)[]
    {
        ("tema", "Tema escolhido", quiz is not null),
        ("age", "Faixa etária", age is not null),
        ("q", "Enunciado escrito", !string.IsNullOrWhiteSpace(statement)),
        ("alts", "4 alternativas preenchidas", optionValues.All(v => !string.IsNullOrWhiteSpace(v))),
        ("right", "Alternativa correta marcada", correct is >= 0 and <= 3),
    };
}
<div>
    <a class="back" asp-page="Index"><svg class="icon" aria-hidden="true"><use href="#i-back"/></svg>Questões</a>
    <div class="page-head">
        <p class="sub">Três passos: o tema, para quem é e a pergunta com as quatro alternativas.</p>
    </div>
</div>

@if (editing)
{
    <div class="note info"><svg aria-hidden="true"><use href="#i-info"/></svg><span>Ao salvar, a questão volta para rascunho e precisa ser aprovada de novo para chegar ao jogo.</span></div>
}

<div class="maker" data-maker>
    <form class="maker-form" method="post" novalidate>
        @if (errors.Count > 0)
        {
            <div class="alert" role="alert" tabindex="-1" id="resumo-erros" autofocus>
                <svg aria-hidden="true"><use href="#i-alert"/></svg>
                <div>
                    @foreach (var e in errors)
                    {
                        <div>@if (e.Key.Length > 0) { <a href="#@Target(e.Key)">@e.Message</a> } else { @e.Message }</div>
                    }
                </div>
            </div>
        }

        <fieldset class="step">
            <legend class="step-h"><span class="n" aria-hidden="true">1</span>Qual é o tema? <span class="visually-hidden">Tipo de quiz, obrigatório.</span><small>Cada tema tem um personagem no jogo</small></legend>
            <div class="theme-pick">
                @foreach (var t in quizTypes)
                {
                    var face = QuizPresentation.Face(t);
                    <label class="tp @QuizPresentation.CssClass(t)">
                        <input type="radio" name="Input.QuizType" value="@t" id="@(t == quizTypes[0] ? "Input_QuizType" : "Input_QuizType_" + t)" checked="@(quiz == t)" aria-invalid="@Bad("QuizType")" aria-describedby="@Desc("QuizType")" data-k="@QuizPresentation.CssClass(t)" />
                        <img src="~/img/@face.File" width="@face.Width" height="@face.Height" alt="" />
                        <b>@IndexModel.QuizLabel(t)</b>
                        <small>@QuizPresentation.Character(t)</small>
                    </label>
                }
            </div>
            @if (Err("QuizType") is { } quizError)
            {
                <span class="field-error" id="Input_QuizType-erro">@quizError</span>
            }
        </fieldset>

        <fieldset class="step">
            <legend class="step-h"><span class="n" aria-hidden="true">2</span>Para quem é? <span class="visually-hidden">Faixa etária, obrigatória.</span></legend>
            <div class="pill-pick" data-group="age">
                @for (var i = 0; i < bands.Length; i++)
                {
                    <label class="pp">
                        <input type="radio" name="Input.AgeBand" value="@bands[i]" id="@(i == 0 ? "Input_AgeBand" : "Input_AgeBand_" + bands[i])" checked="@(age == bands[i])" aria-invalid="@Bad("AgeBand")" aria-describedby="@Desc("AgeBand")" />
                        <span>@IndexModel.BandLabel(bands[i])</span>
                    </label>
                }
            </div>
            @if (Err("AgeBand") is { } ageError)
            {
                <span class="field-error" id="Input_AgeBand-erro">@ageError</span>
            }
        </fieldset>

        <fieldset class="step">
            <legend class="step-h"><span class="n" aria-hidden="true">3</span>Escreva a pergunta</legend>
            <div class="field">
                <label asp-for="Input.Statement">Enunciado <span class="req">(obrigatório)</span></label>
                <textarea class="input textarea" asp-for="Input.Statement" rows="3" maxlength="500" aria-invalid="@Bad("Statement")" aria-describedby="@Desc("Statement")" data-bind="q"></textarea>
                <small>Até 500 caracteres.</small>
                @* Contador: só o painel.js o mostra (#160); sem JS a tela fica igual. *@
                <span class="count-hint" data-count-for="Input_Statement" hidden></span>
                @if (Err("Statement") is { } statementError)
                {
                    <span class="field-error" id="Input_Statement-erro">@statementError</span>
                }
            </div>
            <fieldset class="alts">
                <legend>Alternativas <span class="req">(preencha as quatro e marque a correta)</span></legend>
                @for (var i = 0; i < 4; i++)
                {
                    var field = optionFields[i];
                    <div class="alt">
                        <span class="key" aria-hidden="true">@letters[i]</span>
                        <div>
                            <label class="visually-hidden" for="Input_@field">Alternativa @letters[i]</label>
                            <input class="input" id="Input_@field" name="Input.@field" value="@optionValues[i]" maxlength="300" autocomplete="off"
                                   aria-invalid="@Bad(field)" aria-describedby="@Desc(field)" data-bind="a@(i)" />
                        </div>
                        <label class="correct">
                            <input type="radio" name="Input.Correct" id="@(i == 0 ? "Input_Correct" : "Input_Correct_" + i)" value="@i" checked="@(correct == i)" aria-invalid="@Bad("Correct")" aria-describedby="@Desc("Correct")" />
                            Certa<span class="visually-hidden"> (alternativa @letters[i])</span>
                        </label>
                    </div>
                    @if (Err(field) is { } optionError)
                    {
                        <span class="field-error" id="Input_@(field)-erro">@optionError</span>
                    }
                }
                @if (Err("Correct") is { } correctError)
                {
                    <span class="field-error" id="Input_Correct-erro">@correctError</span>
                }
            </fieldset>
            <div class="field">
                <label asp-for="Input.Explanation">Explicação <span class="req">(obrigatório)</span></label>
                <textarea class="input textarea" asp-for="Input.Explanation" rows="3" maxlength="1000" data-bind="why" aria-invalid="@Bad("Explanation")" aria-describedby="Input_Explanation-ajuda@(Err("Explanation") is null ? "" : " Input_Explanation-erro")"></textarea>
                <small id="Input_Explanation-ajuda">Mostrada ao aluno depois que ele responde.</small>
                @if (Err("Explanation") is { } explanationError)
                {
                    <span class="field-error" id="Input_Explanation-erro">@explanationError</span>
                }
            </div>
        </fieldset>

        <div class="maker-bar">
            <button class="btn btn-primary" type="submit">Salvar</button>
            <a class="link" asp-page="Index">Cancelar</a>
            <span class="hint"><span data-ready-hint></span>Fica como rascunho até ser aprovada.</span>
        </div>
    </form>

    <aside class="maker-preview" aria-labelledby="t-prev-q">
        <p class="pv-label"><span id="t-prev-q">Como o aluno vê</span><span>mostra o que está no formulário</span></p>
        @* Ilustração: repete o que o formulário já diz, então fica fora da leitura de tela. *@
        <div class="phone @(quiz is { } qt ? QuizPresentation.CssClass(qt) : "")" aria-hidden="true" data-preview>
            <div class="screen">
                <div class="gq-head">
                    @if (quiz is { } pt)
                    {
                        var pface = QuizPresentation.Face(pt);
                        <img src="~/img/@pface.File" width="@pface.Width" height="@pface.Height" alt="" data-face />
                    }
                    <span class="@(quiz is null ? "is-empty" : null)" data-show="tname" data-empty="Escolha o tema">@(quiz is { } pn ? IndexModel.QuizLabel(pn) : "Escolha o tema")</span>
                    <span class="lvl" data-show="age">@(age is { } pa ? IndexModel.BandLabel(pa) : "")</span>
                </div>
                <p class="gq @(string.IsNullOrWhiteSpace(statement) ? "is-empty" : "")" data-show="q" data-empty="Sua pergunta aparece aqui">@(string.IsNullOrWhiteSpace(statement) ? "Sua pergunta aparece aqui" : statement)</p>
                <ol class="gq-alts">
                    @for (var i = 0; i < 4; i++)
                    {
                        var text = optionValues[i]?.Trim();
                        var isRight = correct == i;
                        @* Atributos do li nesta ordem (o teste do #154 confere a forma). O texto fica no span para o painel.js trocá-lo sem apagar o ✓. *@
                        <li data-k="@letters[i]" class="@(isRight ? "right" : "")"><span class="@(string.IsNullOrEmpty(text) ? "is-empty" : null)" data-show="a@(i)" data-alt="@i" data-empty="Alternativa @letters[i]">@(string.IsNullOrEmpty(text) ? "Alternativa " + letters[i] : text)</span>@if (isRight) { <span data-tick> ✓</span> }</li>
                    }
                </ol>
                @* Sempre emitido; vazio, some pelo CSS (.gq-why:empty). *@
                <p class="gq-why" data-show="why" data-max="160">@explanation</p>
            </div>
        </div>
        <ul class="ready" aria-label="O que falta">
            @foreach (var item in checklist)
            {
                <li class="@(item.Done ? "ok" : "")" data-check="@item.Key">@item.Label<span class="visually-hidden" data-check-text>@(item.Done ? " (feito)" : " (falta)")</span></li>
            }
        </ul>
    </aside>
</div>
