# Copie para terraform.tfvars (ignorado pelo git). Tudo aqui é opcional: os valores abaixo são os padrões.
# Segredo NÃO entra neste arquivo. Use variáveis de ambiente, só no shell do Terraform:
#   RAILWAY_TOKEN         token de workspace da Railway (lido pelo provider)
#   TF_VAR_seed_password  senha dos usuários do seed sintético; obrigatória enquanto houver seed_enabled
#   TF_VAR_brevo_api_key         chave de API da Brevo; obrigatória só com Email__Provider = "Brevo"
#   TF_VAR_brevo_webhook_secret  opcional; segredo do webhook da Brevo, com 32 caracteres ou mais
#   TF_VAR_ai_api_key            chave do provedor de IA (Sprint 4); só quando Ai__Provider não for "Fake"
# Passo a passo no README: "Para ligar a Brevo".

# Id do workspace; obrigatório se o token enxergar mais de um.
# workspace_id = "00000000-0000-0000-0000-000000000000"

# Um projeto Railway por chave. Produção nasce desligada: só existe se a chave `producao` for acrescentada
# (antes, leia "Produção" no README). O seed só é aceito em homologacao; o subdomínio é único em up.railway.app.
# `dominio_proprio` é opcional e nasce vazio. Preenchido com o nome do host (ex.: "painel.example.org", sem
# https:// e sem barra), cria o domínio próprio do serviço web; os registros a cadastrar no DNS saem em
# `terraform output dns_dominio_proprio`. Passo a passo: docs/operations/railway-dominio.md.
# ambientes = {
#   homologacao = { seed_enabled = true, subdominio = "helinho-homologacao", dominio_proprio = "" } # roda como Staging
#   producao    = {}                                                          # roda como Production
# }

# repositorio     = "dono/repositorio"
# branch          = "main"
# auto_deploy     = false # true: todo push na branch implanta; ative também "Wait for CI" no painel
# regiao          = "us-east4-eqdc4a"
# serverless      = false
# postgres_imagem = "postgres:17.12"

# Configuração sem segredo do serviço web, pelo nome da variável de ambiente. Só as chaves abaixo são aceitas;
# valor vazio não é enviado à Railway.
# variaveis_web = {
#   Api__Auth__TokenLifetime     = "08:00:00"
#   Api__Auth__MaxFailedAttempts = "5"
#   Api__Auth__LockoutDuration   = "00:15:00"
#   Api__Auth__LoginRateLimit    = "10"
#   Api__Auth__LoginRateWindow   = "00:01:00"
#   Email__Provider              = "Fake" # ou "Brevo"; Brevo exige a chave, o remetente e a URL pública
#   Email__DailyLimit            = "300"  # teto diário de envios; "0" = sem teto
#   Brevo__SenderEmail           = ""     # ex.: "nao-responda@example.org", de um domínio autenticado na Brevo
#   Brevo__SenderName            = ""     # ex.: "Universo do Hélinho"; até 70 caracteres
#   App__PublicBaseUrl           = ""     # "https://<host>", sem barra final; vazio + dominio_proprio = https://<dominio_proprio>
#   Ai__Provider                 = "Fake"
#   Ai__Model                    = ""
# }
